<mujoco model="astro_p2 optimized arm collisions scene">
  <!-- SPDX-License-Identifier: BSD-3-Clause -->
  <!-- Arm contact selection follows the Menagerie approach; see LICENSE.Menagerie. -->
  <include file="astro_p2_simplified.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="menagerie_ground" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="300"
      height="300"/>
    <material name="menagerie_ground" texture="menagerie_ground" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light name="menagerie_light" pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="menagerie_floor" pos="0 0 -0.75" size="0 0 0.05" type="plane" material="menagerie_ground"/>
  </worldbody>
  <contact>
    <!-- Retained non-arm geoms keep automatic contacts. Enumerate only optimized arm interactions. -->
    <!-- Arm-floor contact parameters inherit the same defaults as the original Astro geoms. -->
    <pair name="left_shoulder_housing_floor" geom1="left_shoulder_housing_collision" geom2="menagerie_floor"
      condim="3"/>
    <pair name="left_upper_arm_floor" geom1="left_upper_arm_collision" geom2="menagerie_floor" condim="3"/>
    <pair name="left_forearm_floor" geom1="left_forearm_collision" geom2="menagerie_floor" condim="3"/>
    <pair name="left_wrist_roll_floor" geom1="left_wrist_roll_collision" geom2="menagerie_floor" condim="3"/>
    <pair name="left_wrist_pitch_floor" geom1="left_wrist_pitch_collision" geom2="menagerie_floor" condim="3"/>
    <pair name="left_wrist_hand_floor" geom1="left_wrist_hand_collision" geom2="menagerie_floor" condim="3"/>
    <pair name="right_shoulder_housing_floor" geom1="right_shoulder_housing_collision" geom2="menagerie_floor"
      condim="3"/>
    <pair name="right_upper_arm_floor" geom1="right_upper_arm_collision" geom2="menagerie_floor" condim="3"/>
    <pair name="right_forearm_floor" geom1="right_forearm_collision" geom2="menagerie_floor" condim="3"/>
    <pair name="right_wrist_roll_floor" geom1="right_wrist_roll_collision" geom2="menagerie_floor" condim="3"/>
    <pair name="right_wrist_pitch_floor" geom1="right_wrist_pitch_collision" geom2="menagerie_floor" condim="3"/>
    <pair name="right_wrist_hand_floor" geom1="right_wrist_hand_collision" geom2="menagerie_floor" condim="3"/>
    <!-- Upper-body contacts use the three retained main torso capsules and head. -->
    <pair name="left_shoulder_housing_upper_body_1" geom1="left_shoulder_housing_collision"
      geom2="waist_roll_link_1_capsule_collision" condim="1"/>
    <pair name="left_shoulder_housing_upper_body_2" geom1="left_shoulder_housing_collision"
      geom2="waist_roll_link_2_capsule_collision" condim="1"/>
    <pair name="left_shoulder_housing_upper_body_3" geom1="left_shoulder_housing_collision"
      geom2="waist_roll_link_3_capsule_collision" condim="1"/>
    <pair name="left_shoulder_housing_upper_body_4" geom1="left_shoulder_housing_collision"
      geom2="head_link_sphere_collision_1" condim="1"/>
    <pair name="left_upper_arm_upper_body_1" geom1="left_upper_arm_collision"
      geom2="waist_roll_link_1_capsule_collision" condim="1"/>
    <pair name="left_upper_arm_upper_body_2" geom1="left_upper_arm_collision"
      geom2="waist_roll_link_2_capsule_collision" condim="1"/>
    <pair name="left_upper_arm_upper_body_3" geom1="left_upper_arm_collision"
      geom2="waist_roll_link_3_capsule_collision" condim="1"/>
    <pair name="left_upper_arm_upper_body_4" geom1="left_upper_arm_collision" geom2="head_link_sphere_collision_1"
      condim="1"/>
    <pair name="left_forearm_upper_body_1" geom1="left_forearm_collision" geom2="waist_roll_link_1_capsule_collision"
      condim="1"/>
    <pair name="left_forearm_upper_body_2" geom1="left_forearm_collision" geom2="waist_roll_link_2_capsule_collision"
      condim="1"/>
    <pair name="left_forearm_upper_body_3" geom1="left_forearm_collision" geom2="waist_roll_link_3_capsule_collision"
      condim="1"/>
    <pair name="left_forearm_upper_body_4" geom1="left_forearm_collision" geom2="head_link_sphere_collision_1"
      condim="1"/>
    <pair name="left_wrist_roll_upper_body_1" geom1="left_wrist_roll_collision"
      geom2="waist_roll_link_1_capsule_collision" condim="1"/>
    <pair name="left_wrist_roll_upper_body_2" geom1="left_wrist_roll_collision"
      geom2="waist_roll_link_2_capsule_collision" condim="1"/>
    <pair name="left_wrist_roll_upper_body_3" geom1="left_wrist_roll_collision"
      geom2="waist_roll_link_3_capsule_collision" condim="1"/>
    <pair name="left_wrist_roll_upper_body_4" geom1="left_wrist_roll_collision" geom2="head_link_sphere_collision_1"
      condim="1"/>
    <pair name="left_wrist_pitch_upper_body_1" geom1="left_wrist_pitch_collision"
      geom2="waist_roll_link_1_capsule_collision" condim="1"/>
    <pair name="left_wrist_pitch_upper_body_2" geom1="left_wrist_pitch_collision"
      geom2="waist_roll_link_2_capsule_collision" condim="1"/>
    <pair name="left_wrist_pitch_upper_body_3" geom1="left_wrist_pitch_collision"
      geom2="waist_roll_link_3_capsule_collision" condim="1"/>
    <pair name="left_wrist_pitch_upper_body_4" geom1="left_wrist_pitch_collision" geom2="head_link_sphere_collision_1"
      condim="1"/>
    <pair name="left_wrist_hand_upper_body_1" geom1="left_wrist_hand_collision"
      geom2="waist_roll_link_1_capsule_collision" condim="1"/>
    <pair name="left_wrist_hand_upper_body_2" geom1="left_wrist_hand_collision"
      geom2="waist_roll_link_2_capsule_collision" condim="1"/>
    <pair name="left_wrist_hand_upper_body_3" geom1="left_wrist_hand_collision"
      geom2="waist_roll_link_3_capsule_collision" condim="1"/>
    <pair name="left_wrist_hand_upper_body_4" geom1="left_wrist_hand_collision" geom2="head_link_sphere_collision_1"
      condim="1"/>
    <pair name="right_shoulder_housing_upper_body_1" geom1="right_shoulder_housing_collision"
      geom2="waist_roll_link_1_capsule_collision" condim="1"/>
    <pair name="right_shoulder_housing_upper_body_2" geom1="right_shoulder_housing_collision"
      geom2="waist_roll_link_2_capsule_collision" condim="1"/>
    <pair name="right_shoulder_housing_upper_body_3" geom1="right_shoulder_housing_collision"
      geom2="waist_roll_link_3_capsule_collision" condim="1"/>
    <pair name="right_shoulder_housing_upper_body_4" geom1="right_shoulder_housing_collision"
      geom2="head_link_sphere_collision_1" condim="1"/>
    <pair name="right_upper_arm_upper_body_1" geom1="right_upper_arm_collision"
      geom2="waist_roll_link_1_capsule_collision" condim="1"/>
    <pair name="right_upper_arm_upper_body_2" geom1="right_upper_arm_collision"
      geom2="waist_roll_link_2_capsule_collision" condim="1"/>
    <pair name="right_upper_arm_upper_body_3" geom1="right_upper_arm_collision"
      geom2="waist_roll_link_3_capsule_collision" condim="1"/>
    <pair name="right_upper_arm_upper_body_4" geom1="right_upper_arm_collision" geom2="head_link_sphere_collision_1"
      condim="1"/>
    <pair name="right_forearm_upper_body_1" geom1="right_forearm_collision" geom2="waist_roll_link_1_capsule_collision"
      condim="1"/>
    <pair name="right_forearm_upper_body_2" geom1="right_forearm_collision" geom2="waist_roll_link_2_capsule_collision"
      condim="1"/>
    <pair name="right_forearm_upper_body_3" geom1="right_forearm_collision" geom2="waist_roll_link_3_capsule_collision"
      condim="1"/>
    <pair name="right_forearm_upper_body_4" geom1="right_forearm_collision" geom2="head_link_sphere_collision_1"
      condim="1"/>
    <pair name="right_wrist_roll_upper_body_1" geom1="right_wrist_roll_collision"
      geom2="waist_roll_link_1_capsule_collision" condim="1"/>
    <pair name="right_wrist_roll_upper_body_2" geom1="right_wrist_roll_collision"
      geom2="waist_roll_link_2_capsule_collision" condim="1"/>
    <pair name="right_wrist_roll_upper_body_3" geom1="right_wrist_roll_collision"
      geom2="waist_roll_link_3_capsule_collision" condim="1"/>
    <pair name="right_wrist_roll_upper_body_4" geom1="right_wrist_roll_collision" geom2="head_link_sphere_collision_1"
      condim="1"/>
    <pair name="right_wrist_pitch_upper_body_1" geom1="right_wrist_pitch_collision"
      geom2="waist_roll_link_1_capsule_collision" condim="1"/>
    <pair name="right_wrist_pitch_upper_body_2" geom1="right_wrist_pitch_collision"
      geom2="waist_roll_link_2_capsule_collision" condim="1"/>
    <pair name="right_wrist_pitch_upper_body_3" geom1="right_wrist_pitch_collision"
      geom2="waist_roll_link_3_capsule_collision" condim="1"/>
    <pair name="right_wrist_pitch_upper_body_4" geom1="right_wrist_pitch_collision" geom2="head_link_sphere_collision_1"
      condim="1"/>
    <pair name="right_wrist_hand_upper_body_1" geom1="right_wrist_hand_collision"
      geom2="waist_roll_link_1_capsule_collision" condim="1"/>
    <pair name="right_wrist_hand_upper_body_2" geom1="right_wrist_hand_collision"
      geom2="waist_roll_link_2_capsule_collision" condim="1"/>
    <pair name="right_wrist_hand_upper_body_3" geom1="right_wrist_hand_collision"
      geom2="waist_roll_link_3_capsule_collision" condim="1"/>
    <pair name="right_wrist_hand_upper_body_4" geom1="right_wrist_hand_collision" geom2="head_link_sphere_collision_1"
      condim="1"/>
    <!-- Distal arm contacts with the retained ipsilateral hip shells and pelvis. -->
    <pair name="left_forearm_hip_1" geom1="left_forearm_collision" geom2="left_hip_roll_link_1_capsule_collision"
      condim="1"/>
    <pair name="left_forearm_hip_2" geom1="left_forearm_collision" geom2="left_hip_roll_link_cylinder_collision_1"
      condim="1"/>
    <pair name="left_wrist_hand_hip_1" geom1="left_wrist_hand_collision" geom2="left_hip_roll_link_1_capsule_collision"
      condim="1"/>
    <pair name="left_wrist_hand_hip_2" geom1="left_wrist_hand_collision" geom2="left_hip_roll_link_cylinder_collision_1"
      condim="1"/>
    <pair name="left_wrist_hand_pelvis_1" geom1="left_wrist_hand_collision" geom2="pelvis_cylinder_collision_1"
      condim="1"/>
    <pair name="left_wrist_hand_pelvis_2" geom1="left_wrist_hand_collision" geom2="pelvis_1_capsule_collision"
      condim="1"/>
    <pair name="left_wrist_hand_pelvis_3" geom1="left_wrist_hand_collision" geom2="pelvis_upper_shell_collision"
      condim="1"/>
    <pair name="right_forearm_hip_1" geom1="right_forearm_collision" geom2="right_hip_roll_link_1_capsule_collision"
      condim="1"/>
    <pair name="right_forearm_hip_2" geom1="right_forearm_collision" geom2="right_hip_roll_link_cylinder_collision_1"
      condim="1"/>
    <pair name="right_wrist_hand_hip_1" geom1="right_wrist_hand_collision"
      geom2="right_hip_roll_link_1_capsule_collision" condim="1"/>
    <pair name="right_wrist_hand_hip_2" geom1="right_wrist_hand_collision"
      geom2="right_hip_roll_link_cylinder_collision_1" condim="1"/>
    <pair name="right_wrist_hand_pelvis_1" geom1="right_wrist_hand_collision" geom2="pelvis_cylinder_collision_1"
      condim="1"/>
    <pair name="right_wrist_hand_pelvis_2" geom1="right_wrist_hand_collision" geom2="pelvis_1_capsule_collision"
      condim="1"/>
    <pair name="right_wrist_hand_pelvis_3" geom1="right_wrist_hand_collision" geom2="pelvis_upper_shell_collision"
      condim="1"/>
    <!-- Opposite distal arms; no adjacent or rigidly attached same-arm pairs are added. -->
    <pair name="left_forearm_right_forearm" geom1="left_forearm_collision" geom2="right_forearm_collision" condim="1"/>
    <pair name="left_forearm_right_wrist_hand" geom1="left_forearm_collision" geom2="right_wrist_hand_collision"
      condim="1"/>
    <pair name="left_wrist_hand_right_forearm" geom1="left_wrist_hand_collision" geom2="right_forearm_collision"
      condim="1"/>
    <pair name="left_wrist_hand_right_wrist_hand" geom1="left_wrist_hand_collision" geom2="right_wrist_hand_collision"
      condim="1"/>
  </contact>
</mujoco>
